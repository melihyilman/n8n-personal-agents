      "typeVersion": 1,
      "position": [180, 340]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Execute this atomic engineering sub-task using your attached tools.\n\n### SUB-TASK ASSIGNMENT:\nSpecialist Role: {{ $json.assigned_specialist || 'local_coder' }}\nTitle: {{ $json.title }}\nInstructions: {{ $json.prompt_payload }}\nWorkspace Path: {{ $json.workspace_path || $env.WORKSPACE_ROOT || '.' }}\n\n### MANDATORY SELF-LEARNED RAG RULES:\n{{ $json.rag_guardrails || '- Always read file line ranges via tool_fs_read before calling tool_fs_patch.\\n- Always use tool_web_crawl_page with wait_for_js=true for modern docs.\\n- Always call tool_db_schema before writing SQL queries.' }}\n\n### EXECUTION PROTOCOL:\n1. Discover context first (`tool_fs_tree`, `tool_fs_grep`, `tool_fs_semantic_search`, or `tool_web_search`).\n2. Read exact target files (`tool_fs_read`) or crawl documentation (`tool_web_crawl_page`).\n3. Apply surgical code changes (`tool_fs_patch` or `tool_fs_write`) or database operations (`tool_db_query`).\n4. Verify your work by running tests (`tool_shell_exec` e.g. `pytest`) and return a concise summary of changes and test output.",
        "options": {
          "systemMessage": "You are a precise Local Autonomous Software Engineer & Web Researcher running on Ollama (qwen2.5-coder:7b). Never guess file contents or SQL columns; always invoke your inspection tools first.",
          "maxIterations": 12
        }
      },
      "id": "b2020001-0002-4000-8000-000000000002",
      "name": "Local Ollama Worker AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [540, 340]
    },
    {
      "parameters": {
        "model": "={{ $json.worker_model || 'qwen2.5-coder:7b' }}",
        "options": {
          "temperature": 0.1,
          "numCtx": 16384
        }
      },
      "id": "b2020001-0003-4000-8000-000000000003",
      "name": "Ollama Local Model (qwen2.5-coder:7b)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [320, 620]
    },
    {
      "parameters": {
        "toolDescription": "List directory tree of a local workspace folder (respects .gitignore). Input JSON: {\"workspace_path\": \".\", \"max_depth\": 3}",
        "method": "POST",
        "url": "={{ $env.HOST_BRIDGE_URL || 'http://host.docker.internal:8090' }}/tools/fs/tree",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $fromAI('body', 'JSON object with workspace_path and max_depth') }}"
