# ============================================================================
# n8n Personal AI Agent Orchestrator & Developer Board Configuration
# ============================================================================

# --- PostgreSQL + pgvector (Unified Board State + RAG Vector Store) ---
POSTGRES_USER=n8n_agent
POSTGRES_PASSWORD=n8n_agent_secret
POSTGRES_DB=n8n_orchestrator
POSTGRES_PORT=5432
DATABASE_URL=postgresql://n8n_agent:n8n_agent_secret@localhost:5432/n8n_orchestrator

# --- Service Ports ---
N8N_PORT=5678
HOST_BRIDGE_PORT=8090
DEV_BOARD_PORT=3030
SEARXNG_PORT=8088
CRAWL4AI_PORT=11235

# --- Local LLM (Ollama on macOS Host) ---
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_LOCAL_URL=http://localhost:11434
OLLAMA_WORKER_MODEL=qwen2.5-coder:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Paid Orchestrator LLM Providers (Multi-Provider Support) ---
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEFAULT_ORCHESTRATOR_PROVIDER=gemini
DEFAULT_ORCHESTRATOR_MODEL=gemini-2.5-pro

# --- Workspace & Local Paths ---
WORKSPACE_ROOT=.
SKILLS_DIR=~/.gemini/config/skills
N8N_RUNTIME_BIN=
N8N_USER_FOLDER=

# --- Host Bridge & Web Search ---
HOST_BRIDGE_URL=http://host.docker.internal:8090
HOST_BRIDGE_LOCAL_URL=http://localhost:8090
HOST_BRIDGE_TOKEN=local-dev-secret-token
SEARXNG_LOCAL_URL=http://localhost:8088
CRAWL4AI_LOCAL_URL=http://localhost:11235
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

